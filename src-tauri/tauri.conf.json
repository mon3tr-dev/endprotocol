{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "endprotocol",
  "version": "0.1.0",
  "identifier": "cn.msk-network.endprotocol",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "endprotocol",
        "width": 1200,
        "height": 700,
        "resizable": true,
        "center": true,
        "decorations": false,
        "transparent": true,
        "windowEffects": {
          "effects": ["acrylic"],
          "color": [18, 18, 20, 30]
        }
      },
      {
        "label": "tray-panel",
        "title": "tray-panel",
        "url": "/tray-panel.html",
        "width": 260,
        "height": 340,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "windowEffects": {
          "effects": ["acrylic"],
          "color": [18, 18, 20, 30]
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],

    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",

        "installMode": "currentUser",

        "startMenuFolder": "ENDPROTOCOL",

        "languages": ["SimpChinese", "English"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkxRkJCMzc4NjkwODk0MEUKUldRT2xBaHBlTFA3a2NUUXN1L3o2VU13UDYzRnNjRVlVSXFDMlA0ODV0K25EWkozdU9Lcm9MRWQK",
      "endpoints": [
        "https://updates.msk-network.cn/stable/latest.json",
        "https://updates.msk-network.cn/preview/latest.json",
        "https://github.com/soldiereleven/endprotocol/releases/latest/download/latest.json"
      ]
    }
  }
}
